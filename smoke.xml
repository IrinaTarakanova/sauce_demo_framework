<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite" >

    <listeners>
        <listener class-name="tarakanova.utils.Listener"/>
    </listeners>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="tarakanova.tests.LoginTest"/>
            <class name="tarakanova.tests.ProductsTest"/>
            <class name="tarakanova.tests.CartPageTest"/>
            <class name="tarakanova.tests.CheckoutPageTest"/>
        </classes>

    </test>

</suite>